+        try {
+          switch (operation) {
+            case 0:
+              g0->send(input.data(), input.size() * sizeof(float), 1);
+              break;
+            case 1:
+              g0->recv(output.data(), input.size() * sizeof(float), 1);
+              break;
+            case 2:
+              g0->all_sum(
+                  input.data(),
