+TEST_CASE("test failed CPU dispatch does not leak active tasks") {
+  auto stream = new_stream(Device::cpu);
+  auto& encoder = cpu::get_command_encoder(stream);
+  for (int i = 1; i < cpu::DISPATCHES_PER_TASK; i++) {
+    encoder.dispatch([] {});
+  }
+  synchronize(stream);
+  auto baseline = scheduler::n_active_tasks();
+  auto release = std::make_shared<std::promise<void>>();
+  auto gate = release->get_future().share();
+  auto finished = std::make_shared<std::promise<void>>();
+  auto done = finished->get_future();
+  scheduler::enqueue(stream, [gate] {
+    gate.wait();
+    throw std::runtime_error("collective aborted");
+  });
+  scheduler::enqueue(stream, [finished] { finished->set_value(); });
+  release->set_value();
+  REQUIRE(done.wait_for(std::chrono::seconds(5)) == std::future_status::ready);
+  CHECK_THROWS_WITH_AS(
+      encoder.dispatch([] {}), "collective aborted", std::runtime_error);
+  CHECK_EQ(scheduler::n_active_tasks(), baseline);
+  CHECK_NOTHROW(synchronize(stream));
+
+  for (int i = 1; i < cpu::DISPATCHES_PER_TASK; i++) {
+    encoder.dispatch([] {});
+  }
+  release = std::make_shared<std::promise<void>>();
+  gate = release->get_future().share();
+  encoder.dispatch([gate] {
+    gate.wait();
+    throw std::runtime_error("collective aborted again");
+  });
+  CHECK_EQ(scheduler::n_active_tasks(), baseline + 1);
+  release->set_value();
+  CHECK_THROWS_WITH_AS(
+      synchronize(stream), "collective aborted again", std::runtime_error);
+  CHECK_EQ(scheduler::n_active_tasks(), baseline);
+}
