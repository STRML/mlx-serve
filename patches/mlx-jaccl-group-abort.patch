+        } catch (const std::runtime_error& e) {
+          return std::string(e.what());
+        }
+        return std::string{};
+      });
+      auto deadline =
+          std::chrono::steady_clock::now() + std::chrono::seconds(5);
+      while (fabric.poll_calls.load() < before + 100 &&
