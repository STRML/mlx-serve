+TEST_CASE("test failed CPU task still signals its completion event") {
+  auto stream = new_stream(Device::cpu);
+  auto release = std::make_shared<std::promise<void>>();
+  auto gate = release->get_future().share();
+  auto finished = std::make_shared<std::promise<void>>();
+  auto done = finished->get_future();
+  scheduler::enqueue(stream, [gate] {
+    gate.wait();
+    throw std::runtime_error("collective aborted");
+  });
+  scheduler::enqueue(stream, [finished] { finished->set_value(); });
+  release->set_value();
+  REQUIRE(done.wait_for(std::chrono::seconds(5)) == std::future_status::ready);
+
+  Event event(stream);
+  event.set_value(1);
+  CHECK_NOTHROW(event.signal(stream));
+  auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!event.is_signaled() && std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::yield();
+  }
+  CHECK(event.is_signaled());
+  if (gpu::is_available()) {
+    auto consumer = new_stream(Device::gpu);
+    event.wait(consumer);
+    CHECK_THROWS_WITH_AS(
+        synchronize(consumer), "collective aborted", std::runtime_error);
+    CHECK_NOTHROW(synchronize(consumer));
+  }
+  CHECK_THROWS_WITH_AS(
+      event.check_error(), "collective aborted", std::runtime_error);
+  CHECK_NOTHROW(scheduler::check_error(stream));
+  CHECK_EQ(sum(arange(4, stream)).item<int>(), 6);
+  CHECK_EQ(sum(arange(4, new_stream(Device::cpu))).item<int>(), 6);
+}
+
+TEST_CASE("test CPU synchronize drains work before reporting a pending error") {
+  auto stream = new_stream(Device::cpu);
+  auto release_error = std::make_shared<std::promise<void>>();
+  auto error_gate = release_error->get_future().share();
+  auto tail_started = std::make_shared<std::promise<void>>();
+  auto started = tail_started->get_future();
+  auto release_tail = std::make_shared<std::promise<void>>();
+  auto tail_gate = release_tail->get_future().share();
+  std::atomic<bool> tail_done{false};
+  scheduler::enqueue(stream, [error_gate] {
+    error_gate.wait();
+    throw std::runtime_error("collective aborted");
+  });
+  scheduler::enqueue(stream, [tail_started, tail_gate, &tail_done] {
+    tail_started->set_value();
+    tail_gate.wait();
+    tail_done.store(true);
+  });
+  release_error->set_value();
+  REQUIRE(
+      started.wait_for(std::chrono::seconds(5)) == std::future_status::ready);
+
+  std::promise<void> returned;
+  auto returned_future = returned.get_future();
+  bool returned_before_tail = false;
+  std::thread release([&] {
+    returned_before_tail =
+        returned_future.wait_for(std::chrono::milliseconds(100)) ==
+        std::future_status::ready;
+    release_tail->set_value();
+  });
+  CHECK_THROWS_WITH_AS(
+      synchronize(stream), "collective aborted", std::runtime_error);
+  returned.set_value();
+  release.join();
+  CHECK_FALSE(returned_before_tail);
+  CHECK(tail_done.load());
+  CHECK_NOTHROW(synchronize(stream));
+}
