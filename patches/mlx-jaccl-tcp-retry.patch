 namespace jaccl {
 
+// jaccl-tcp-patch v2: bind to the local IPv4 address that shares the destination's subnet, so the connect uses that
+// interface's scoped route. No match leaves the socket unbound.
+static void bind_to_subnet(int sock, const address_t& addr) {
+  if (addr.addr.ss_family != AF_INET) return;
+  auto dst = reinterpret_cast<const sockaddr_in*>(&addr.addr)->sin_addr.s_addr;
+  struct ifaddrs* list = nullptr;
+  if (getifaddrs(&list) != 0) return;
+  for (auto* ifa = list; ifa != nullptr; ifa = ifa->ifa_next) {
+    if (ifa->ifa_addr == nullptr || ifa->ifa_netmask == nullptr || ifa->ifa_addr->sa_family != AF_INET) continue;
+    auto local = reinterpret_cast<sockaddr_in*>(ifa->ifa_addr)->sin_addr.s_addr;
+    auto mask = reinterpret_cast<sockaddr_in*>(ifa->ifa_netmask)->sin_addr.s_addr;
+    if (mask == 0 || (local & mask) != (dst & mask)) continue;
+    sockaddr_in src = {};
+    src.sin_family = AF_INET;
+    src.sin_addr.s_addr = local;
+    ::bind(sock, reinterpret_cast<sockaddr*>(&src), sizeof(src));
+    break;
+  }
+  freeifaddrs(list);
+}
+
+// jaccl-tcp-patch: a connect a signal interrupted is still in progress; wait for it rather than abandon it.
+static int finish_connect(int sock) {
+  struct pollfd p = {sock, POLLOUT, 0};
+  int r;
+  do {
+    r = poll(&p, 1, 10000);
+  } while (r < 0 && errno == EINTR);
+  if (r <= 0) {
+    if (r == 0) errno = ETIMEDOUT;
+    return -1;
+  }
+  int err = 0;
+  socklen_t len = sizeof(err);
+  if (getsockopt(sock, SOL_SOCKET, SO_ERROR, &err, &len) < 0) return -1;
+  if (err != 0) {
+    errno = err;
+    return -1;
+  }
+  return 0;
+}
