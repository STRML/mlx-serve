--- /dev/null
+++ b/mlx/tp_sum_hook.h
@@ -0,0 +1,45 @@
+// Copyright © 2026 Apple Inc.
+
+#pragma once
+
+#include <time.h>
+#include <atomic>
+#include <cstdint>
+
+namespace mlx::core {
+
+// The phases of one tensor-parallel sum on the CPU stream, in order: the wait
+// task for the GPU's fence starts spinning, sees the fence, the collective is
+// entered (arg: bytes) and returns, and the CPU's fence update that releases
+// the GPU's wait runs.
+enum class TpSumPhase : uint32_t {
+  WaitBegin,
+  FenceSeen,
+  SumEnter,
+  SumReturn,
+  Release,
+};
+
+using TpSumHook = void (*)(uint32_t phase, uint64_t arg, uint64_t ns);
+
+inline std::atomic<TpSumHook> tp_sum_hook{nullptr};
+
+struct TpSumStamp {
+  TpSumHook hook;
+  uint64_t ns;
+};
+
+// Reads the clock only when a hook is set, so the stamp is taken at the call
+// site and the hook runs after it.
+inline TpSumStamp tp_sum_now() {
+  auto hook = tp_sum_hook.load(std::memory_order_relaxed);
+  return {hook, hook ? clock_gettime_nsec_np(CLOCK_UPTIME_RAW) : 0};
+}
+
+inline void tp_sum_emit(TpSumStamp s, TpSumPhase phase, uint64_t arg = 0) {
+  if (s.hook) {
+    s.hook(static_cast<uint32_t>(phase), arg, s.ns);
+  }
+}
+
+} // namespace mlx::core
