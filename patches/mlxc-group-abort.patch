+++ b/mlx/c/distributed_group.cpp
@@ -59,6 +59,45 @@ extern "C" int mlx_distributed_group_size(mlx_distributed_group group) {
   }
 }
 
+extern "C" int
+mlx_distributed_group_abort(mlx_distributed_group group, const char* reason) {
+  try {
+    if (!reason) {
+      throw std::invalid_argument("expected a non-null abort reason");
+    }
+    mlx_distributed_group_get_(group).abort(reason);
+    return 0;
+  } catch (std::exception& e) {
+    mlx_error("%s", e.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_distributed_group_progress(
+    mlx_distributed_group group,
+    uint64_t* output) {
+  try {
+    if (!output) {
+      throw std::invalid_argument("expected a non-null progress output");
+    }
+    *output = mlx_distributed_group_get_(group).progress();
+    return 0;
+  } catch (std::exception& e) {
+    mlx_error("%s", e.what());
+    return 1;
+  }
+}
+
+extern "C" int mlx_distributed_clear_backends(void) {
+  try {
+    mlx::core::distributed::clear_backends();
+    return 0;
+  } catch (std::exception& e) {
+    mlx_error("%s", e.what());
+    return 1;
+  }
+}
