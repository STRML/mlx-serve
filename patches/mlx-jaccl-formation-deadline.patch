+// jaccl-deadline-patch v1: one absolute CLOCK_MONOTONIC ms deadline for group formation, 0 = none.
+static std::atomic<int64_t> formation_deadline_ms{0};
+
+static int64_t monotonic_ms() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<int64_t>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+// Milliseconds left before the deadline: -1 with no deadline, 0 once it has passed.
+static int deadline_left_ms() {
+  int64_t d = formation_deadline_ms.load(std::memory_order_acquire);
+  if (d == 0) return -1;
+  int64_t left = d - monotonic_ms();
+  if (left <= 0) return 0;
+  return left > 0x7fffffff ? 0x7fffffff : static_cast<int>(left);
+}
+
+// Waits for `events` on `fd` until the formation deadline; throws when it passes first. No deadline: returns at once
+// and the caller's blocking call waits as before.
+static void wait_until_deadline(int fd, short events, const char* tag, const char* what) {
+  for (;;) {
+    int left = deadline_left_ms();
+    if (left < 0) return;
+    struct pollfd p = {fd, events, 0};
+    int r = left == 0 ? 0 : poll(&p, 1, left);
+    if (r > 0) return;
+    if (r < 0 && errno == EINTR) continue;
+    if (r < 0) return;
+    std::ostringstream msg;
+    msg << tag << " formation deadline passed in " << what;
+    throw std::runtime_error(msg.str());
+  }
+}
